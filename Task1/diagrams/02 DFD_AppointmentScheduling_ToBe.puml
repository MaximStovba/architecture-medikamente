@startuml DFD_AppointmentScheduling

!includeurl https://raw.githubusercontent.com/ArmanAvanesyan/DFD-PlantUML/main/DFD_Level_1.puml
!$LEVEL="DFD Level 1"

startDfd("2. Запись на приём")

' External Entities
External(ePatient, "Пациент")
External(eReceptionist, "Ресепшн")

' Main Process
Process("Запись на приём")
    SubProcess(sp21, "2.1", "Создание записи\nна приём")
    SubProcess(sp22, "2.2", "Заключение\nконтракта")

' Data Stores
DataStore(d1, "D1: Журнал записи\nна приём (Excel)")
DataStore(d2, "D2: Контракты\nс пациентами (PDF/JPG)")
DataStore(d3, "D3: Контактные данные\nпациентов (Excel)")

' Data Flows
DataFlows()
    Flow(ePatient, sp21, "ФИО, дата и время приёма\n[Шифрование, маскирование]\n@tag:PII_SCHEDULE")
    Flow(ePatient, sp21, "Контактные данные:\nтелефон, e-mail\n[Шифрование]\n@tag:PII")
    Flow(sp21, d1, "Сохранение записи:\nФИО + дата/время\n[Шифрование]\n@tag:PII_SCHEDULE")
    Flow(sp21, d3, "Контактные данные пациента\n[Шифрование, контроль доступа]\n@tag:PII")

    Flow(eReceptionist, sp21, "Вводит данные\nв расписание")

    Flow(ePatient, sp22, "Полис или паспорт\n[Шифрование, защита документов]\n@tag:CONTRACT_REF")
    Flow(eReceptionist, sp22, "Оформляет контракт")
    Flow(sp22, d2, "Скан или копия договора\n[Шифрование, контроль доступа]\n@tag:CONTRACT_DOC")

endDfd()

@enduml
