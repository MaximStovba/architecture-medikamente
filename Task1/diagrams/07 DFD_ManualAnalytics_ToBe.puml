@startuml DFD_ManualAnalytics

!includeurl https://raw.githubusercontent.com/ArmanAvanesyan/DFD-PlantUML/main/DFD_Level_1.puml
!$LEVEL="DFD Level 1"

startDfd("7. Ручная аналитика")

' External Entities
External(eReceptionist, "Ресепшн")
External(eCashier, "Кассир")
External(eDoctor, "Врач")
External(eAnalyst, "Бизнес-аналитик")

' Main Process
Process("Формирование отчётов вручную")
    SubProcess(sp71, "7.1", "Сбор данных из Excel")
    SubProcess(sp72, "7.2", "Создание аналитических отчётов")

' Data Stores
DataStore(d1, "D1: Excel-файлы\n(журнал приёмов)")
DataStore(d2, "D2: Excel-файлы\n(журнал оплат)")
DataStore(d3, "D3: Excel-файлы\n(медицинские данные)")
DataStore(d4, "D4: Jupyter/Notebook\n(отчёты, сводные таблицы)")

' Data Flows
DataFlows()

    ' 7.1 — сбор данных из разных Excel-файлов
    Flow(eReceptionist, sp71, "Выгрузка графика приёмов\n[Обезличивание, маскирование]\n@tag:PII_SCHEDULE")
    Flow(eCashier, sp71, "Выгрузка данных об оплатах\n[Обезличивание ID, контроль доступа]\n@tag:FINANCIAL")
    Flow(eDoctor, sp71, "Выгрузка медицинских записей\n[Обезличивание, шифрование]\n@tag:MEDICAL_SENSITIVE")

    Flow(sp71, d1, "Сводная таблица по визитам\n[Обезличивание]\n@tag:AGGREGATE_DATA")
    Flow(sp71, d2, "Сводная таблица по платежам\n[Обезличивание]\n@tag:AGGREGATE_DATA")
    Flow(sp71, d3, "Файл с медицинскими данными\n[Шифрование, ограничение доступа]\n@tag:MEDICAL_SENSITIVE")

    ' 7.2 — ручная аналитика
    Flow(eAnalyst, sp72, "Объединяет выгрузки\nв аналитическую модель\n[Обезличивание]\n@tag:ANALYTICS_PII")
    Flow(sp72, d4, "Отчёты в Jupyter:\nвыручка, поток, заболевания\n[Обезличивание, аудит]\n@tag:ANALYTICS_PII")

endDfd()

@enduml
